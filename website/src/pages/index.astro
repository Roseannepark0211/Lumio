---

<Layout>
  {/* ==================== 顶部导航 ==================== */}
  <nav id="top-nav" class="fixed top-0 left-0 right-0 z-40 bg-[rgb(var(--color-bg)/0.72)] border-b border-[rgb(var(--color-border)/0.08)]" style="backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%);">
    <div class="container-narrow flex items-center justify-between py-3.5">
      <a href="#top" class="flex items-center gap-2">
        <Logo3DGlow size="sm" breathing={false} shimmer={false} />
      </a>
      <div class="flex items-center gap-2">
        <a href="#features" class="eyebrow hidden md:inline hover:text-[rgb(var(--color-text))] transition-colors px-3 py-2" data-i18n="nav.features">功能</a>
        <a href="#demo" class="eyebrow hidden md:inline hover:text-[rgb(var(--color-text))] transition-colors px-3 py-2" data-i18n="nav.demo">演示</a>
        <a href="#faq" class="eyebrow hidden md:inline hover:text-[rgb(var(--color-text))] transition-colors px-3 py-2" data-i18n="nav.faq">FAQ</a>
        <a href="#download" class="eyebrow hidden md:inline hover:text-[rgb(var(--color-text))] transition-colors px-3 py-2" data-i18n="nav.download">下载</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn-ghost text-sm !py-2 !px-4 ml-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </a>
        {/* 移动端汉堡菜单按钮 — < 768px 显示 */}
        <button
          id="mobile-menu-toggle"
          class="mobile-menu-btn md:hidden"
          aria-label="打开菜单"
          data-i18n-attr="aria-label:nav.menu.open"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    {/* 移动端下拉面板 */}
    <div id="mobile-menu" class="mobile-menu md:hidden">
      <div class="mobile-menu__inner">
        <a href="#features" class="mobile-menu__link" data-close>
          <span class="eyebrow">§ 01</span>
          <span data-i18n="nav.features">功能</span>
        </a>
        <a href="#demo" class="mobile-menu__link" data-close>
          <span class="eyebrow">§ 02</span>
          <span data-i18n="nav.demo">演示</span>
        </a>
        <a href="#faq" class="mobile-menu__link" data-close>
          <span class="eyebrow">§ 03</span>
          <span data-i18n="nav.faq">FAQ</span>
        </a>
        <a href="#download" class="mobile-menu__link" data-close>
          <span class="eyebrow">§ 04</span>
          <span data-i18n="nav.download">下载</span>
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="mobile-menu__link" data-close>
          <span class="eyebrow">§ 05</span>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </nav>

  {/* ==================== Hero ==================== */}
  <section id="top" class="relative pt-32 pb-20 md:pt-40 md:pb-32 overflow-hidden">
    <div class="container-narrow relative">
      <div class="max-w-3xl mx-auto text-center reveal">
        {/* 巨型字标 — Geist Bold */}
        <div class="flex justify-center mb-8 reveal" style="transition-delay: 0.1s;">
          <Logo3DGlow size="xl" />
        </div>

        {/* 主标语 — v5 调整
            强调不只是照片，还有视频：舞台直拍 / Live Photo / 视频原档
            "留下来" 替换 "存进媒体库"，避免在 Hero 用完媒体库一词后其他位置无词可用 */}
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.1] tracking-tight mb-6 reveal" style="transition-delay: 0.2s;" data-i18n-html="hero.title">
          把喜欢的一切<br />
          <span class="text-gradient">留下来</span>
        </h1>

        <p class="text-lg md:text-xl text-[rgb(var(--color-text-muted))] leading-relaxed mb-10 max-w-2xl mx-auto reveal" style="transition-delay: 0.3s;" data-i18n-html="hero.subtitle">
          粘贴链接，Lumio 替你整理。<br class="hidden md:inline" />
          爱豆照片、舞台直拍、Live Photo、视频原档，原画质自动入库。
        </p>

        {/* CTA */}
        <div class="flex flex-wrap items-center justify-center gap-3 mb-10 reveal" style="transition-delay: 0.4s;">
          <button type="button" class="btn-primary" data-download-trigger>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"/>
            </svg>
            <span data-i18n="hero.cta.download">下载 Lumio</span>
          </button>
          <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn-ghost">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
            <span data-i18n="hero.cta.source">查看源码</span>
          </a>
        </div>

        {/* 平台标识 */}
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-[rgb(var(--color-text-dim))] reveal" style="transition-delay: 0.5s;">
          <span class="font-mono" data-i18n="hero.badge.windows">Windows 10+</span>
          <span class="opacity-30">·</span>
          <span class="font-mono">MIT License</span>
          <span class="opacity-30">·</span>
          <span class="font-mono" data-i18n="hero.badge.ffmpeg">内置 ffmpeg</span>
        </div>
      </div>
    </div>
  </section>

  {/* ==================== 痛点 — 情感共鸣 ==================== */}
  <section class="section !pt-8 !pb-20">
    <div class="container-narrow">
      <div class="pain-card max-w-2xl mx-auto text-center reveal">
        <p class="text-2xl md:text-3xl font-medium leading-relaxed text-[rgb(var(--color-text-muted))]">
          <span data-i18n="pain.l1">看到的，</span><br />
          <span class="text-[rgb(var(--color-text))]" data-i18n="pain.l2">留不住</span><br />
