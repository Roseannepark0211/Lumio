---
/**
 * Lumio 官网首页 v4
 *
 * v4 调整（用户反馈）：
 * 1. 字体切换 Geist + 直角基调（去掉所有圆角，呼应几何技术感）
 * 2. 删除 Instrument Serif 衬线 italic 点睛，避免「存进相册」渲染问题
 * 3. 定位从「数字相册」改为「媒体库 / 素材库」
 * 4. 删除卖点 ⑤ Liquid Glass（不再宣传设计语言）
 * 5. 看看区域重设为「数字资产仪表盘」— 纯 CSS/SVG 渲染，无截图依赖
 * 6. 暗夜模式 + 机械直角咔哒声音效
 *
 * 内容：按宣传任务书 4 大卖点
 *       ① 高清解析 → ② 无水印 → ③ 浏览器插件 → ④ 素材库（最大卖点）
 * 去掉：批量下载（迁移后未开始）、Liquid Glass 设计语言宣传
 */
import Layout from '../layouts/Layout.astro';
import Logo3DGlow from '../components/Logo3DGlow.astro';
import DownloadDialog from '../components/DownloadDialog.astro';
import ChangelogSection from '../components/ChangelogSection.astro';
import SiteFooter from '../components/SiteFooter.astro';

// 真实地址
const GITHUB_URL = 'https://github.com/Roseannepark0211/Lumio';
const GITHUB_RELEASES = 'https://github.com/Roseannepark0211/Lumio/releases';
const VERSION = '4.4.7';

