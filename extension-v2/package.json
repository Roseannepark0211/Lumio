{
  "name": "lumio-extension",
  "private": true,
  "version": "4.4.6",
  "type": "module",
  "description": "Lumio browser extension - send media to Lumio desktop client",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview",
    "icons": "tsx scripts/generate-icons.ts",
    "package": "npm run build && cd dist && zip -r lumio-extension-v4.4.6.zip ."
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "sharp": "^0.33.4",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
